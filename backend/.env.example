# Database
DATABASE_URL=postgresql+psycopg2://fieldos:fieldos@localhost:5432/fieldos

# Gnani AI
GNANI_API_KEY=your_gnai_api_key
GNANI_PRISMA_ENDPOINT=https://api.gnani.ai/prisma/stt
GNANI_TIMBRE_ENDPOINT=https://api.gnani.ai/timbre/tts

# Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# LLM (Optional - for Operational Intelligence)
LLM_API_KEY=your_llm_api_key
LLM_PROVIDER=evon

# App
APP_NAME=FieldOS
APP_ENV=development