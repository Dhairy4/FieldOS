# Database (PostgreSQL via psycopg v3)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/fieldos

# Gnani AI (Voice Intelligence - Prisma ASR & Timbre TTS)
GNANI_API_KEY=vach_your_gnani_api_key_here
GNANI_BASE_URL=https://api.vachana.ai
GNANI_TTS_VOICE=Pranav
GNANI_TTS_MODEL=timbre-v2.5
GNANI_STT_MODEL=prisma-v2.5

# Speech provider: "gnani" for Gnani AI, "mock" for local offline testing
SPEECH_PROVIDER=gnani

# Security — generate a unique value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required to be >=32 chars when APP_ENV=production.
SECRET_KEY=replace-with-a-strong-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Comma-separated list of allowed browser origins. Never use "*" in production.
CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# Local development only. Production refuses to start when SQLite fallback is
# enabled and will not seed demo data.
ALLOW_SQLITE_FALLBACK=true
SEED_DEMO_DATA=true

# Voice upload limits and rate limiting.
MAX_AUDIO_BYTES=10485760
VOICE_RATE_LIMIT_PER_MINUTE=60

# App
APP_NAME=FieldOS
APP_ENV=development
